{
  "name": "8-crud",
  "version": "1.0.0",
  "private": true,
  "description": "Learn It, Love It: temas de aprendizaje con enlaces y votos. Express + EJS + MVC + JavaScript puro.",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./src/public/css/app.css --watch",
    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
