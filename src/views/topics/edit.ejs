<%- include('../partials/head') %>
<main class="mx-auto max-w-2xl px-4 py-8">
  <a href="/topics/<%= topic.id %>" class="text-sm text-slate-500 hover:text-indigo-600">&larr; Volver al tema</a>
  <h1 class="mt-3 text-2xl font-bold tracking-tight">Editar tema</h1>
  <%# method-override convierte ?_method=PUT en una request PUT real %>
  <form action="/topics/<%= topic.id %>?_method=PUT" method="POST" class="js-validated mt-5 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/errors', { errors: errors }) %>
    <div>
      <label for="title" class="block text-sm font-medium">Titulo</label>
      <input id="title" name="title" type="text" required minlength="3" maxlength="120" value="<%= values.title || '' %>" autofocus class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-700 dark:bg-slate-800">
    </div>
    <div>
      <label for="description" class="block text-sm font-medium">Descripcion</label>
      <textarea id="description" name="description" rows="4" maxlength="1000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-700 dark:bg-slate-800"><%= values.description || '' %></textarea>
    </div>
    <div class="flex gap-2">
      <button class="rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700">Guardar cambios</button>
      <a href="/topics/<%= topic.id %>" class="rounded-lg border border-slate-300 px-4 py-2 hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800">Cancelar</a>
    </div>
  </form>
</main>
<%- include('../partials/foot') %>
