<%- include('partials/head') %>
<main class="mx-auto max-w-2xl px-4 py-20 text-center">
  <p class="text-6xl font-bold text-slate-300 dark:text-slate-700"><%= status %></p>
  <h1 class="mt-3 text-xl font-semibold"><%= message %></h1>
  <a href="/" class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Volver al inicio</a>
  <% if (stack) { %><pre class="mt-8 overflow-x-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-slate-300"><%= stack %></pre><% } %>
</main>
<%- include('partials/foot') %>
